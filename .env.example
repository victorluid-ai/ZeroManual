ZEROMANUAL_ENV=dev
ZEROMANUAL_INTERFACE_HOST=0.0.0.0
ZEROMANUAL_INTERFACE_PORT=8090
ZEROMANUAL_DB_PATH=runtime/zeromanual.db
ZEROMANUAL_WEBHOOK_SECRET=change_me_webhook_secret

# Facturación/agentes viven en OpsCenter (:8091). Esta key ya no es necesaria
# para el admin web; se mantiene por compatibilidad de settings.
ZEROMANUAL_API_KEY=

N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678
N8N_WEBHOOK_BASE_URL=http://localhost:5678/webhook
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me

# n8n API (portal de clientes — duplicar workflows por cliente)
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_TEMPLATE_IDS={"google_reviews": "", "gmb_posts": ""}

# Google OAuth (portal cliente)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8090/client/google/callback
# One-time on the ZeroManual GCP project (not per customer): enable
# mybusinessaccountmanagement.googleapis.com,
# mybusinessbusinessinformation.googleapis.com,
# mybusiness.googleapis.com

# Stripe (pagos web comercial). Sin STRIPE_SECRET_KEY el checkout
# otorga suscripción en modo "free"/dev sin cobrar.
ZEROMANUAL_PUBLIC_URL=http://localhost:8090
ZEROMANUAL_STRIPE_SECRET_KEY=
ZEROMANUAL_STRIPE_PUBLISHABLE_KEY=
ZEROMANUAL_STRIPE_WEBHOOK_SECRET=
ZEROMANUAL_STRIPE_TRIAL_DAYS=14
# Opcional: Price IDs de Stripe Dashboard.
# Formato JSON: {"google_reviews:monthly":"price_xxx","google_reviews:yearly":"price_yyy"}
# Si está vacío se usan price_data dinámicos del catálogo servidor.
ZEROMANUAL_STRIPE_PRICE_IDS={}

# ---------------------------------------------------------------------------
# Mantenimiento (apps/mantenimiento) — Supabase PostgreSQL
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
MANTENIMIENTO_PORT=8100
MANTENIMIENTO_DEFAULT_GROUP_SLUG=sabores-atlanticos
# Sin credenciales Supabase, forzar demo en memoria:
# MANTENIMIENTO_DEMO_MODE=true

